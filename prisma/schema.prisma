generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  whatsappNumber String   @map("whatsapp_number")
  tasks          Task[]
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("users")
}

model Task {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  title                String
  description          String?
  course               String?
  status               String            @default("not_started")
  currentDeadline      DateTime          @map("current_deadline")
  progressPercent      Int               @default(0) @map("progress_percent")
  progressUpdatedAt    DateTime          @default(now()) @map("progress_updated_at")
  difficulty           String            @default("medium")
  basePriority         String            @default("medium")
  estimatedTimeMinutes Int               @default(0) @map("estimated_time_minutes")
  lastNotifiedAt       DateTime?         @map("last_notified_at")

  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  checklists           TaskChecklist[]
  notificationLogs     NotificationLog[]

  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  @@index([userId])
  @@map("tasks")
}

model TaskChecklist {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  title     String
  isChecked Boolean  @default(false) @map("is_checked")
  type      String   // "subtask" atau "preparation_item"

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklists")
}

model NotificationLog {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  notificationType String   @map("notification_type") // "deadline_h3d" | "deadline_h1d" | "deadline_h3h" | "deadline_h30m" | "overdue" | "preparation" | "stagnation_Xd"
  channel          String   @default("whatsapp")
  sentAt           DateTime @default(now()) @map("sent_at")

  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, notificationType, channel])
  @@index([taskId])
  @@map("notification_logs")
}
